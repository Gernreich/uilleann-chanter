# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# uilleann_chanter is Rust (repro-svg builds the crate first) and names its
# own sheet, so it writes into $OUT's directory and the tool compares the
# file it asked for. The crate builds on practice-chanters, square-flute and
# lasermade-tools, and through practice-chanters on four-hole-ocarinas,
# swept-curve and bore-tmm, all checked out beside this one.

cut-files/uilleann-chanter-sheet1-cut-files.svg :: target/release/uilleann_chanter --out=$(dirname $OUT)
previews/uilleann-chanter-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/uilleann-chanter-sheet1-cut-files.svg $OUT
turn.html :: target/release/uilleann_chanter --page-to=$OUT
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft design: its script, the design (slimmed by sc-slim so it
# is the same every run), and the STEP file SolidCraft builds from it ---
solidcraft/uilleann-chanter-square-bore.solidcraft.json :: target/release/uilleann_chanter --solidcraft=$(dirname $OUT)
solidcraft/uilleann-chanter-square-bore.sc :: target/release/uilleann_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/uilleann-chanter-square-bore.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/uilleann-chanter-square-bore.step :: target/release/uilleann_chanter --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/uilleann-chanter-square-bore.solidcraft.json --out $OUT --quiet
